{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Create Notes",
  "mainBinaryName": "CreateNotes",
  "version": "1.0.2",
  "identifier": "com.hammad15.createnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43127",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "Create Notes",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Hammad15",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "23f02078-dce0-5baa-b2b5-622cf290db9b"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
