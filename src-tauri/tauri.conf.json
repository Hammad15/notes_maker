{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Notes",
  "version": "0.1.0",
  "identifier": "com.studynotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43127",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Study Notes",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#141310"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
